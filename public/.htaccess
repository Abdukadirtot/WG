# Caching + serving rules for the static export on Apache / LiteSpeed hosting.
#
# The problem this prevents: if the HTML is cached for a long time, a redeploy
# changes the hashed chunk filenames, and the stale HTML keeps requesting the
# OLD chunk names — which no longer exist — causing 404s and ChunkLoadError.
#
# Fix: never long-cache HTML (always revalidate), but cache the immutable,
# content-hashed assets under /_next/static forever.

<IfModule mod_headers.c>
  # HTML: always revalidate so a new deploy is picked up immediately.
  <FilesMatch "\.(html)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # Hashed build assets: safe to cache forever (filename changes on rebuild).
  <FilesMatch "\.(js|css|woff2|woff|ttf|svg|png|jpg|jpeg|gif|webp|avif|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Fallback: if a hashed asset is missing (stale request after a redeploy),
# don't return the HTML page as if it were JS/CSS — return a real 404.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
</IfModule>

# Gzip/text compression where available.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

ErrorDocument 404 /404.html
